
SECRET_KEY=your_secret_key
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# TIERRA-VIVA TENANT (STANDBY PRODUCTION TEMPLATE)
# ==============================================================================
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://tierraviva.com.mx
BACKEND_INTERNAL_URL=http://tierraviva-backend:8000

# Néctar Labs M2M Zero-Trust RPC Handshake (Apunta a VPS Hub vía IP/DNS)
NECTAR_HUB_API_URL=https://api.nectarlabs.com
NECTAR_TENANT_ID=c2918492-f04b-4a56-b088-75c6130b9102
NECTAR_HMAC_SECRET=replace-with-tierraviva-api-key-uuid-secret
NECTAR_CLIENT_TIMEOUT=4.5

# Redis Local Tenant Cache
REDIS_URL=redis://tierraviva-redis:6379/0
